# Copy to .env.local for local development. Never commit real keys.
# In production, set these in the Vercel project settings (Environment Variables).

# LLM provider used by the serverless functions in /api. Only read server-side.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Optional. Raises the GitHub API rate limit for the evidence connector.
GITHUB_TOKEN=
